# WhatsApp (Baileys)
WHATSAPP_PHONE_NUMBER=2348012345678
BAILEYS_SHIM_URL=http://localhost:8002
# Port the FastAPI app itself listens on (matches `--port` below and PORT= further down).
# The shim POSTs /internal/message and /internal/owner-command here.
BAILEYS_INTERNAL_PORT=8000
# Owner's WhatsApp number (no +, no @s.whatsapp.net) — shim routes /deliver texts from
# this number to /internal/owner-command instead of /internal/message.
OWNER_PHONE_NUMBER=2348012345678

# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/bizagent

# App
APP_ENV=development
PORT=8000
